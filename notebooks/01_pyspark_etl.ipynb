)

import mlflow
import mlflow.data
from mlflow.data.spark_dataset import SparkDataset
from mlflow.metrics import genai

# COMMAND ----------

from pyspark.sql import SparkSession

# Checks if running inside Databricks environment
try:
    spark
    print("Running natively on Databricks Serverless Compute.")
except NameError:
