# COMMAND ----------

# DBTITLE 1,Cell 4
# Delta Lake ACID transaction features
# Note: On Serverless compute, optimizeWrite and autoCompact are enabled by default
# and cannot be configured via spark.conf.set(). To control these per-table, use:
# - Table property: delta.autoOptimize.optimizeWrite
# - Table property: delta.autoOptimize.autoCompact
print("Serverless compute: Delta optimizations enabled by default")

# COMMAND ----------

# Setup Catalog and Database Schema
CATALOG = "main"
SCHEMA = "market_intelligence"

spark.sql(f"CREATE CATALOG IF NOT EXISTS {CATALOG}")
spark.sql(f"CREATE SCHEMA IF NOT EXISTS {CATALOG}.{SCHEMA}")
spark.sql(f"USE CATALOG {CATALOG}")
spark.sql(f"USE SCHEMA {SCHEMA}")

# COMMAND ----------

# MAGIC %md
# MAGIC ## 1. Bronze Layer: Raw Ingestion to Delta Lake
# MAGIC * Ingest raw JSON payload feeds into a append-only streaming/batch Delta table.

# COMMAND ----------

# Define schema for incoming raw JSON feed
raw_schema = StructType([
    StructField("feed_id", StringType(), True),
    StructField("timestamp", StringType(), True),
    StructField("source", StringType(), True),
    StructField("title", StringType(), True),
    StructField("raw_content", StringType(), True),
    StructField("sector", StringType(), True)
])

# COMMAND ----------

# Mock raw market feed payloads
mock_raw_data = [
    {
        "feed_id": "feed_101",
        "timestamp": "2026-08-10T08:30:00Z",
        "source": "Bloomberg Green",
        "title": "APAC Clean Energy Investment Reaches Record $45B in H1 2026",
        "raw_content": "Clean energy infrastructure spending across Southeast Asia spiked due to new grid modernization subsidies...",
        "sector": "Green Tech"
    },
    {
        "feed_id": "feed_102",
        "timestamp": "2026-08-10T09:15:00Z",
        "source": "TechCrunch AI",
        "title": "Enterprise GenAI Infrastructure Deployments Surge Across APAC",
        "raw_content": "Companies are migrating from external API wrappers to self-hosted orchestration platforms like LangGraph on Databricks...",
        "sector": "AI Infrastructure"
    }
]

# COMMAND ----------

# Write to Bronze Delta Table
# New data here flows: Bronze → Silver (with CDF) → Vector Search Delta Sync Index
raw_df = spark.createDataFrame(mock_raw_data, schema=raw_schema)

bronze_table_path = f"{CATALOG}.{SCHEMA}.bronze_market_feeds"
raw_df.write \
    .format("delta") \
    .mode("append") \
    .option("mergeSchema", "true") \
    .saveAsTable(bronze_table_path)

print(f"Bronze table updated: {bronze_table_path}")

# COMMAND ----------

# MAGIC %md
# MAGIC ## 2. Silver Layer: Cleaning, Deduplication & Structural Transformation
# MAGIC * Parse timestamps, sanitize text content, remove duplicates
# MAGIC * Configure for Delta Sync vector index:
# MAGIC   - Change Data Feed (CDF) enabled
# MAGIC   - PRIMARY KEY constraint on `feed_id`
# MAGIC   - Incremental processing (append mode)

# COMMAND ----------

# DBTITLE 1,Cell 11
bronze_df = spark.table(bronze_table_path)

silver_df = (
    bronze_df
    .filter(F.col("raw_content").isNotNull())
    .withColumn("ingested_at", F.to_timestamp(F.col("timestamp")))
    .withColumn("clean_content", F.regexp_replace(F.col("raw_content"), r"\s+", " "))
    .dropDuplicates(["feed_id"])
)

silver_table_path = f"{CATALOG}.{SCHEMA}.silver_market_chunks"

# Initial table creation with CDF enabled
silver_df.write \
    .format("delta") \
    .mode("append") \
    .option("mergeSchema", "true") \
    .option("delta.enableChangeDataFeed", "true") \
    .saveAsTable(silver_table_path)

# Add PRIMARY KEY constraint (required for Delta Sync vector index)
spark.sql(f"""
    ALTER TABLE {silver_table_path} 
    ADD CONSTRAINT silver_pk PRIMARY KEY(feed_id)
""")

# Ensure CDF is enabled (idempotent)
spark.sql(f"ALTER TABLE {silver_table_path} SET TBLPROPERTIES (delta.enableChangeDataFeed = true)")

print(f"✓ Silver table configured for Delta Sync: {silver_table_path}")
print(f"  - CDF enabled: ✓")
print(f"  - PRIMARY KEY: feed_id")
print(f"  - Mode: Incremental (append + merge)")

# COMMAND ----------

# MAGIC %md
# MAGIC ## 3. Gold Layer: Aggregated Market Insights Synthesis
# MAGIC * Structure processed insights for downstream query & multi-agent execution.

# COMMAND ----------

silver_data = spark.table(silver_table_path)

gold_df = (
    silver_data
    .groupBy("sector")
    .agg(
        F.count("feed_id").alias("total_sources"),
        F.collect_list("title").alias("source_titles"),
        F.concat_ws(" | ", F.collect_list("clean_content")).alias("aggregated_context"),
        F.max("ingested_at").alias("last_updated")
    )
)

gold_table_path = f"{CATALOG}.{SCHEMA}.gold_market_summary"
gold_df.write \
    .format("delta") \
    .mode("overwrite") \
    .saveAsTable(gold_table_path)

print(f"Gold table written: {gold_table_path}")

# COMMAND ----------

# DBTITLE 1,Vector Search & Semantic Retrieval
# MAGIC %md
# MAGIC ## 3.5. Vector Search Delta Sync for Semantic Retrieval
# MAGIC * Automatically sync `silver_market_chunks` changes to Unity Catalog Vector Search index
# MAGIC * Enable semantic search over market intelligence feeds
# MAGIC * Managed embeddings using Databricks `databricks-gte-large-en` model

# COMMAND ----------

# DBTITLE 1,Setup Vector Search Delta Sync Index
from databricks.sdk import WorkspaceClient

w = WorkspaceClient()

# Vector Search configuration
VS_ENDPOINT_NAME = "market_intelligence_vs_endpoint"
VS_INDEX_NAME = f"{CATALOG}.{SCHEMA}.silver_market_chunks_vs_index"

# Step 1: Create Vector Search Endpoint (if not exists)
try:
    endpoint = w.vector_search_endpoints.get_endpoint(VS_ENDPOINT_NAME)
    print(f"✓ Using existing Vector Search endpoint: {VS_ENDPOINT_NAME}")
except Exception:
    print(f"Creating Vector Search endpoint: {VS_ENDPOINT_NAME}...")
    endpoint = w.vector_search_endpoints.create_endpoint(
        name=VS_ENDPOINT_NAME,
        endpoint_type="STANDARD"  # Use STORAGE_OPTIMIZED for large-scale deployments
    )
    print(f"✓ Endpoint created: {VS_ENDPOINT_NAME}")

# Step 2: Create Delta Sync Index with Managed Embeddings
try:
    index_info = w.vector_search_indexes.get_index(VS_INDEX_NAME)
    print(f"✓ Vector Search index already exists: {VS_INDEX_NAME}")
except Exception:
    print(f"Creating Delta Sync vector index: {VS_INDEX_NAME}...")
    index = w.vector_search_indexes.create_index(
        name=VS_INDEX_NAME,
        endpoint_name=VS_ENDPOINT_NAME,
        primary_key="feed_id",  # Must match PRIMARY KEY constraint
        index_type="DELTA_SYNC",
        delta_sync_index_spec={
            "source_table": silver_table_path,
            "embedding_source_columns": [
                {
                    "name": "clean_content",  # Text column to embed
                    "embedding_model_endpoint_name": "databricks-gte-large-en"  # Databricks managed embedding model
                }
            ],
            "pipeline_type": "TRIGGERED"  # Use "CONTINUOUS" for real-time auto-sync
        }
    )
    print(f"✓ Delta Sync index created: {VS_INDEX_NAME}")

print("\n" + "="*60)
print("DELTA SYNC CONFIGURATION COMPLETE")
print("="*60)
print(f"Source Table:  {silver_table_path}")
print(f"Vector Index:  {VS_INDEX_NAME}")
print(f"Primary Key:   feed_id")
print(f"Embed Column:  clean_content")
print(f"Pipeline:      TRIGGERED (manual sync via sync_index())")
print(f"\nℹ️  Change pipeline_type to 'CONTINUOUS' for automatic real-time sync")
print("="*60)

# COMMAND ----------

# DBTITLE 1,Trigger Delta Sync Update
# Trigger manual sync for TRIGGERED pipeline
# (Skip this if using CONTINUOUS pipeline_type - it auto-syncs in real-time)

print(f"Syncing vector index with latest Delta table changes...")
w.vector_search_indexes.sync_index(index_name=VS_INDEX_NAME)
print(f"✓ Sync triggered successfully")
print(f"\nℹ️  New data from bronze → silver will now be embedded and indexed")
print("   Query the index to retrieve semantically similar market intelligence")

# COMMAND ----------

# DBTITLE 1,Query Vector Index (Semantic Search)
# Example: Query the vector index for semantic search
query = "What are the latest trends in clean energy investments?"

print(f"Semantic search query: '{query}'")
print("\nSearching vector index...\n")

results = w.vector_search_indexes.query_index(
    index_name=VS_INDEX_NAME,
    columns=["feed_id", "title", "clean_content", "source", "sector"],
    query_text=query,
    num_results=3
)

print("="*80)
print("TOP SEMANTIC SEARCH RESULTS")
print("="*80)

for idx, doc in enumerate(results.result.data_array, 1):
    feed_id, title, content, source, sector, score = doc
    print(f"\n[{idx}] Similarity Score: {score:.4f}")
    print(f"    Title:  {title}")
    print(f"    Source: {source}")
    print(f"    Sector: {sector}")
    print(f"    Content Preview: {content[:120]}...")
    print("-" * 80)

# COMMAND ----------

# MAGIC %md
# MAGIC ## 4. MLflow Automated Evaluation Pipeline
# MAGIC * Log Delta Lake dataset lineage and evaluate generated responses using `mlflow.evaluate()`.

# COMMAND ----------

# Set MLflow Experiment
mlflow.set_experiment("/Shared/Market_Intelligence_Evaluation")

# Prepare test benchmark evaluation dataset from Gold Delta Table
eval_pyspark_df = spark.table(gold_table_path).select(
    F.col("sector").alias("inputs"),
    F.col("aggregated_context").alias("context")
)

# Convert evaluation dataset into SparkDataset object for tracking lineage
eval_dataset: SparkDataset = mlflow.data.from_spark(
    eval_pyspark_df,
    table_name=gold_table_path,
    version="1"
)

# Simulated Agent Prediction Logic (Replace with actual LangGraph runner)
def mock_agent_pipeline(inputs: pd.DataFrame) -> pd.Series:
    """Mock agent inference callable for MLflow evaluate harness."""
    results = []
    for _, row in inputs.iterrows():
        sector = row["inputs"]
        results.append(f"Synthetic summary for {sector}: Investment and infrastructure growth trends show strong 5-10 year momentum.")
    return pd.Series(results)

# COMMAND ----------

# MAGIC %md
# MAGIC ### Execute MLflow Evaluation Run

# COMMAND ----------

with mlflow.start_run(run_name="MLflow_Delta_ETL_Eval") as run:
    # Log MLflow Dataset Lineage
    mlflow.log_input(eval_dataset, context="eval")
    
    # Convert Spark DataFrame to Pandas for local evaluation evaluation execution
    eval_data_pd = eval_pyspark_df.toPandas()
    eval_data_pd["targets"] = eval_data_pd["inputs"].apply(
        lambda x: f"Accurate APAC market analysis for {x}"
    )

    # Run model predictions
    predictions = mock_agent_pipeline(eval_data_pd[["inputs"]])
    eval_data_pd["predictions"] = predictions
    
    # Log predictions as artifact
    mlflow.log_table(eval_data_pd, artifact_file="evaluation_results.json")

    # Display evaluation results
    print("\n==================================================")
    print("MLFLOW EVALUATION RESULTS")
    print("==================================================")
    print(f"Evaluated {len(eval_data_pd)} samples")
    print("\nPredictions logged to MLflow artifact store")
    print("==================================================")

    # Save artifact paths
    mlflow.log_params({
        "catalog": CATALOG,
        "schema": SCHEMA,
        "bronze_table": bronze_table_path,
        "silver_table": silver_table_path,
        "gold_table": gold_table_path
    })

# COMMAND ----------

