# Copy to .env and fill only the values required for the feature you are running.
# Never commit real credentials.

# Agent and evaluation model configuration. Local Ollama is the cost-controlled default.
AGENT_LLM_PROVIDER=ollama
AGENT_LLM_MODEL=qwen2.5:14b
RAGAS_JUDGE_PROVIDER=ollama
RAGAS_JUDGE_MODEL=qwen2.5:14b
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=1200
RAGAS_NUM_CTX=8192
RAGAS_NUM_PREDICT=2048
RAGAS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Databricks workspace access (prefer supported identity or secret mechanisms)
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_AUTH_TYPE=
DATABRICKS_CONFIG_PROFILE=
DATABRICKS_AUTH_SECRET_SCOPE=
DATABRICKS_CLIENT_ID_SECRET_KEY=
DATABRICKS_CLIENT_SECRET_SECRET_KEY=
DATABRICKS_VECTOR_SEARCH_ENDPOINT=market_intelligence_vs_endpoint
DATABRICKS_VECTOR_SEARCH_INDEX=main.market_intelligence.silver_market_chunks_vector_index
DATABRICKS_SOURCE_TABLE=main.market_intelligence.silver_market_chunks
DATABRICKS_VECTOR_SEARCH_PRIMARY_KEY=feed_id
DATABRICKS_SEARCH_TOP_K=5
DATABRICKS_EMBEDDING_SOURCE_COLUMN=clean_content
DATABRICKS_EMBEDDING_MODEL_ENDPOINT=databricks-bge-large-en
DATABRICKS_GOLD_TABLE=main.market_intelligence.gold_market_summary

# MLflow tracking
MLFLOW_TRACKING_URI=

# Set only when deploying a model version that already exists in Unity Catalog
DATABRICKS_MODEL_VERSION=
LLM_API_KEY_SECRET_SCOPE=
LLM_API_KEY_SECRET_KEY=
